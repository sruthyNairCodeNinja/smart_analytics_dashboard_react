PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_factory_dashboard
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# One origin, or a comma-separated list (e.g. your Vercel production domain
# plus a preview deployment URL)
CLIENT_ORIGIN=http://localhost:5173

# How often (ms) the simulation engine generates a new reading per machine
SIMULATION_INTERVAL_MS=5000

# Seed admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@smartfactory.io
SEED_ADMIN_PASSWORD=Admin123!
